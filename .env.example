# Instagram / Meta
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
INSTAGRAM_SHARE_TO_FEED=true
INSTAGRAM_STATUS_TIMEOUT=600
INSTAGRAM_STATUS_POLL_SECONDS=5
INSTAGRAM_UPLOAD_TIMEOUT=900

# Quiz test mode: one mixed JSON -> exactly 5 questions
QUIZ_SIZE=5
MIX_ONLY=true

# Video
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
FPS=30
VIDEO_CRF=30
VIDEO_PRESET=ultrafast
COUNTDOWN_SECONDS=1
POST_AUDIO_WAIT_SECONDS=1.5
ANSWER_SLIDE_DURATION=2
BACKGROUND_VOLUME=0.22
TICK_VOLUME=0.70
CORRECT_VOLUME=0.90

# TTS
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_CONCURRENCY=5

PAGE_URL=https://smartlearninglab-react.pages.dev
